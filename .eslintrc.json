{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "prefer-const": "error",
    "consistent-return": "error",
    "eqeqeq": ["error", "always"],
    "@typescript-eslint/no-explicit-any": "off"
  },
  "env": {
    "node": true,
    "es2022": true
  }
}
